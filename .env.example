# Copie para .env.local e preencha com os valores do seu projeto Supabase.
# (.env.local está no .gitignore — nunca é versionado.)
#
# Onde achar: Supabase Dashboard → Project Settings → API
#   - Project URL          → SUPABASE_URL
#   - anon / public key     → SUPABASE_ANON_KEY (pode aparecer no app com prefixo VITE_)
#   - service_role key      → SUPABASE_SERVICE_ROLE_KEY  (SEGREDO — só p/ scripts locais de admin)

SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
# Opcional (só para scripts administrativos locais; nunca vai pro front nem pro git):
SUPABASE_SERVICE_ROLE_KEY=
